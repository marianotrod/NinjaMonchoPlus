{
  "descripcion": "Tipos de enemigos: quién aparece en cada nivel y cómo se mueve cada uno",
  "query": "?debug&nivel=1",
  "pasos": [
    {"hasta": "window.prueba && prueba.enJuego() && prueba.estado().fase === 'recoleccion'", "timeout": 8000, "nombre": "arranca la Recolección"},
    {"eval": "(prueba.proteger(1), prueba.sinCajasArmas())"},
    {"wait": 6500},
    {"verificar": "en el nivel 1 aparecen demonios, hasta el tope de 3", "eval": "({ enemigos: prueba.estado().enemigos })", "espera": {"enemigos": {"min": 1, "max": 3}}},
    {"verificar": "en el nivel 1 solo aparecen saltarines", "eval": "prueba.enemigos().every(e => e.clave === 'demonio_saltarin')"},
    {"eval": "(prueba.sinEnemigos(), prueba.ponerJugador(1, 60, 264), prueba.proteger(1))"},
    {"wait": 300},
    {"eval": "(prueba.crearEnemigo('demonio_saltarin', 300, 100), true)"},
    {"wait": 1500},
    {"eval": "window.ys = []; window.muestreo = setInterval(() => { const e = prueba.enemigo(0); if (e) ys.push(e.y); }, 50); true"},
    {"wait": 1500},
    {"verificar": "el saltarín rebota (sube y baja)", "eval": "(clearInterval(muestreo), { rango: Math.max(...ys) - Math.min(...ys) })", "espera": {"rango": {"min": 20}}},
    {"eval": "prueba.sinEnemigos()"},
    {"eval": "(prueba.crearEnemigo('demonio_caminante', 300, 264), window.x0 = 300, true)"},
    {"wait": 800},
    {"verificar": "el caminante camina por el piso", "eval": "(() => { const e = prueba.enemigo(0); return { dx: Math.abs(e.x - x0), y: e.y }; })()", "espera": {"dx": {"min": 20}, "y": {"min": 255, "max": 270}}},
    {"eval": "prueba.sinEnemigos()"},
    {"eval": "(prueba.crearEnemigo('espiritu_volador', 300, 120), true)"},
    {"wait": 1200},
    {"verificar": "el volador no cae al piso", "eval": "prueba.enemigo(0).y < 240"},
    {"eval": "prueba.sinEnemigos()"},
    {"eval": "(prueba.crearEnemigo('lanzador', 300, 264), true)"},
    {"hasta": "prueba.proyectiles().enemigos > 0", "timeout": 4000, "nombre": "el lanzador dispara"},
    {"verificar": "el lanzador se queda quieto y tira bolas de fuego", "eval": "(() => { const e = prueba.enemigo(0); return { quieto: Math.abs(e.x - 300) < 8, bolas: prueba.proyectiles().enemigos }; })()", "espera": {"quieto": true, "bolas": {"min": 1}}},
    {"eval": "prueba.sinEnemigos()"},
    {"eval": "(prueba.crearItem('coin', 200, 60), prueba.items().find(i => !i.talisman).valor)"},
    {"wait": 2500},
    {"verificar": "la moneda pierde valor al rebotar", "eval": "(() => { return prueba.items().some(i => !i.talisman && i.valor < 200); })()"}
  ]
}
