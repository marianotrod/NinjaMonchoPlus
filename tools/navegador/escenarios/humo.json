{
  "descripcion": "Recorrido rápido desde el título: menú, nivel 1 con teclado, Cacería, pergaminos y nivel 2",
  "query": "?debug",
  "pasos": [
    {"hasta": "window.prueba && prueba.escenas().includes('TitleScene')", "timeout": 8000, "nombre": "pantalla de título"},
    {"wait": 1500},
    {"shot": "titulo"},
    {"press": "Enter"},
    {"hasta": "prueba.enJuego()", "timeout": 4000, "nombre": "ENTER en el título arranca el juego"},
    {"verificar": "arranca el nivel 1 con un jugador", "eval": "prueba.estado()", "espera": {"nivel": 1, "jugadores": 1, "fase": "intro"}},
    {"shot": "intro"},
    {"hasta": "prueba.estado().fase === 'recoleccion'", "timeout": 4000, "nombre": "arranca la Recolección"},
    {"eval": "window.x0 = prueba.jugador(1).x"},
    {"down": "ArrowRight"},
    {"wait": 400},
    {"press": "ArrowUp", "delay": 300},
    {"wait": 300},
    {"up": "ArrowRight"},
    {"verificar": "las flechas mueven al ninja y saltan", "eval": "({ avanzo: prueba.jugador(1).x - x0 })", "espera": {"avanzo": {"min": 20}}},
    {"press": "x"},
    {"wait": 1500},
    {"verificar": "la Recolección sigue en curso y el reloj corre", "eval": "prueba.estado()", "espera": {"fase": "recoleccion", "tiempo": {"min": 50, "max": 59}}},
    {"shot": "juego"},
    {"eval": "(prueba.proteger(1), prueba.completarRecoleccion())"},
    {"hasta": "prueba.estado().fase === 'caceria'", "timeout": 4000, "nombre": "Cacería"},
    {"shot": "caceria"},
    {"wait": 1500, "eval": "prueba.terminarCaceria(true)"},
    {"hasta": "prueba.estado().fase === 'nivelCompletado' && prueba.estado().listoParaContinuar", "timeout": 4000, "nombre": "nivel completado"},
    {"shot": "nivel_completado"},
    {"press": "Enter"},
    {"hasta": "prueba.enJuego() && prueba.estado().fase === 'sala'", "timeout": 8000, "nombre": "sala de pergaminos"},
    {"wait": 700},
    {"shot": "pergaminos"},
    {"eval": "prueba.tocarCarta(1, 0)"},
    {"hasta": "prueba.enJuego() && prueba.estado().nivel === 2", "timeout": 5000, "nombre": "nivel 2"},
    {"verificar": "el nivel 2 arranca con el puntaje del nivel 1", "eval": "prueba.estado().puntajes[0] > 0"},
    {"shot": "nivel2"}
  ]
}
