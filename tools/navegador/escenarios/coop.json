{
  "descripcion": "Cooperativo: atravesarse, trampolín, empujones sin daño, vidas y puntaje por jugador",
  "query": "?debug&nivel=1&jugadores=2",
  "pasos": [
    {"hasta": "window.prueba && prueba.enJuego() && prueba.estado().fase === 'recoleccion'", "timeout": 8000, "nombre": "arranca la Recolección"},
    {"verificar": "hay dos jugadores", "eval": "({ jugadores: prueba.estado().jugadores, j2: !!prueba.jugador(2) })", "espera": {"jugadores": 2, "j2": true}},
    {"wait": 2000, "eval": "prueba.sinEnemigos() && prueba.sinCajasArmas() && prueba.sinItems()"},
    {"hasta": "prueba.listo(1) && prueba.listo(2)", "timeout": 4000, "nombre": "los dos en el piso"},
    {"eval": "(prueba.proteger(1), prueba.proteger(2), prueba.ponerJugador(2, 60, 264), prueba.ponerJugador(1, 62, 264))"},
    {"wait": 250},
    {"verificar": "los ninjas se atraviesan entre sí", "eval": "Math.abs(prueba.jugador(1).x - prueba.jugador(2).x) < 6"},
    {"eval": "prueba.ponerJugador(1, 60, 224, 0, 150)"},
    {"wait": 250},
    {"verificar": "caer sobre la cabeza del compañero es un trampolín", "eval": "({ vy: prueba.jugador(1).vy, arriba: prueba.jugador(1).y < prueba.jugador(2).y - 20 })", "espera": {"vy": {"max": -150}, "arriba": true}},
    {"wait": 1200},
    {"eval": "(prueba.ponerJugador(1, 60, 264), prueba.ponerJugador(2, 76, 264), prueba.mirar(1, 1), prueba.atacar(1))"},
    {"wait": 100},
    {"verificar": "la katana empuja al compañero sin dañarlo", "eval": "prueba.jugador(2)", "espera": {"vx": {"min": 50}, "aturdido": false, "muerto": false}},
    {"wait": 1000},
    {"eval": "(prueba.ponerJugador(1, 60, 264), prueba.ponerJugador(2, 90, 264), prueba.equipar(1, 'bomba'), prueba.mirar(1, 1), prueba.disparar(1))"},
    {"hasta": "prueba.proyectiles().jugador.length === 0", "timeout": 3500, "nombre": "explota la bomba"},
    {"verificar": "la explosión no daña al compañero", "eval": "({ ...prueba.jugador(2), vidas: prueba.estado().vidas })", "espera": {"aturdido": false, "muerto": false, "vidas": [3, 3]}},
    {"wait": 1500},
    {"eval": "(prueba.conEnemigos(), prueba.completarRecoleccion())"},
    {"hasta": "prueba.estado().fase === 'caceria'", "timeout": 8000, "nombre": "empieza la Cacería"},
    {"wait": 1600, "eval": "(prueba.sinEnemigos(), prueba.crearEnemigo('demonio_caminante', 440, 264), prueba.ponerJugador(2, 60, 264), prueba.mirar(2, 1), true)"},
    {"wait": 300, "eval": "(prueba.crearEnemigo('demonio_caminante', 76, 264), prueba.enfurecerEnemigos(), window.p = prueba.estado().puntajes, prueba.atacar(2))"},
    {"wait": 150},
    {"verificar": "cada jugador suma su propio puntaje", "eval": "({ j1: prueba.estado().puntajes[0] - p[0], j2: prueba.estado().puntajes[1] - p[1] })", "espera": {"j1": 0, "j2": 100}},
    {"eval": "(prueba.quitarProteccion(1), prueba.golpear(1))"},
    {"hasta": "prueba.estado().vidas[0] === 2", "timeout": 4000, "nombre": "J1 pierde una vida"},
    {"verificar": "las vidas no se comparten", "eval": "prueba.estado()", "espera": {"vidas": [2, 3]}},
    {"hasta": "prueba.listo(1)", "timeout": 6000, "nombre": "J1 reaparece"},
    {"eval": "(prueba.ponerVidas(1, 1), prueba.quitarProteccion(1), prueba.golpear(1))"},
    {"hasta": "prueba.jugador(1).eliminado", "timeout": 4000, "nombre": "J1 se queda sin vidas"},
    {"verificar": "un jugador sin vidas queda afuera y el otro sigue", "eval": "({ fase: prueba.estado().fase, vidas: prueba.estado().vidas, j2Muerto: prueba.jugador(2).muerto })", "espera": {"fase": "caceria", "vidas": [0, 3], "j2Muerto": false}},
    {"eval": "(prueba.ponerVidas(2, 1), prueba.quitarProteccion(2), prueba.golpear(2))"},
    {"hasta": "prueba.estado().fase === 'fin'", "timeout": 4000, "nombre": "game over"},
    {"verificar": "sin nadie en pie, termina la partida", "eval": "prueba.estado()", "espera": {"fase": "fin", "vidas": [0, 0]}}
  ]
}
