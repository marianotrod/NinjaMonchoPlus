{
  "descripcion": "Pergaminos de nivel 2 y peligros: plataforma fantasma, bolas celestes, parry en el dash, minas y bombas especiales",
  "query": "?debug&nivel=3&mapa=n-peligros",
  "pasos": [
    {"hasta": "window.prueba && prueba.enJuego() && prueba.estado().fase === 'recoleccion'", "timeout": 8000, "nombre": "arranca la Recolección"},
    {"hasta": "prueba.listo(1)", "timeout": 4000, "nombre": "J1 en el piso"},
    {"wait": 2200},
    {"eval": "(window.escena = window.game.scene.getScene('NinjaMonchoScene'), prueba.sinEnemigos(), prueba.sinFuego(), prueba.sinItems(), prueba.ponerTiempo(90), window.azarReal = Math.random, true)"},

    {"eval": "(prueba.darHabilidades(1, ['dobleSalto'], 2), escena.duracion = 600, prueba.proteger(1), prueba.ponerJugador(1, 200, 264), window.pasarelas = prueba.contarTiles(2), true)"},
    {"wait": 300},
    {"press": "ArrowUp", "delay": 80},
    {"wait": 150},
    {"press": "ArrowUp", "delay": 80},
    {"wait": 50},
    {"verificar": "doble salto nivel 2: deja una plataforma fantasma de pasarelas alineadas a la grilla", "eval": "prueba.contarTiles(2) > pasarelas"},
    {"wait": 900},
    {"verificar": "la plataforma desaparece sola", "eval": "prueba.contarTiles(2) === pasarelas"},

    {"eval": "(prueba.darHabilidades(1, ['caidaPesada'], 2), prueba.ponerJugador(1, 200, 150), true)"},
    {"down": "ArrowDown"},
    {"hasta": "prueba.proyectiles().jugador.filter(p => p.tipo === 'bolaCeleste').length === 2", "timeout": 1500, "nombre": "la caída pesada toca el piso"},
    {"up": "ArrowDown"},
    {"verificar": "caída pesada nivel 2: al golpear el piso salen dos bolas celestes del jugador", "eval": "window.escena.proyectilesDe('jugadores').filter(p => p.tipo === 'bolaCeleste').every(p => p.tintTopLeft === 0x7dd3fc)"},
    {"eval": "(prueba.crearEnemigo('lanzador', 104, 264), prueba.crearEnemigo('lanzador', 296, 264), prueba.ponerJugador(1, 200, 150), true)"},
    {"down": "ArrowDown"},
    {"hasta": "prueba.enemigos().some(e => e.aturdido)", "timeout": 2000, "nombre": "una bola celeste toca a un demonio"},
    {"up": "ArrowDown"},
    {"verificar": "las bolas celestes golpean a los demonios", "eval": "prueba.enemigos().some(e => e.aturdido)"},
    {"eval": "(prueba.sinEnemigos(), escena.proyectiles.clear(true, true), true)"},
    {"wait": 300},

    {"eval": "(prueba.darHabilidades(1, ['dash'], 2), prueba.quitarProteccion(1), prueba.ponerJugador(1, 200, 264), prueba.mirar(1, 1), prueba.proyectilEnemigo(270, 262, -120, 0), true)"},
    {"press": "ArrowRight", "delay": 30},
    {"wait": 40},
    {"press": "ArrowRight", "delay": 30},
    {"wait": 300},
    {"verificar": "dash nivel 2: un proyectil enemigo que toca durante el dash se para y no golpea", "eval": "({ proyectiles: prueba.proyectiles().enemigos, aturdido: prueba.jugador(1).aturdido })", "espera": {"proyectiles": 0, "aturdido": false}},
    {"wait": 600},

    {"eval": "(prueba.proteger(1), prueba.ponerJugador(1, 100, 264), prueba.soltarPeligro('mina', 250, 250), true)"},
    {"wait": 300},
    {"eval": "(prueba.quitarProteccion(1), prueba.vaciarTalismanes(), prueba.ponerJugador(1, 244, 260), true)"},
    {"hasta": "prueba.peligros().length === 0", "timeout": 1000, "nombre": "J1 pisa la mina"},
    {"verificar": "una mina explota al tocarla y golpea al jugador", "eval": "prueba.jugador(1).aturdido"},
    {"hasta": "!prueba.jugador(1).invulnerable", "timeout": 3000, "nombre": "termina el parpadeo"},

    {"eval": "(prueba.proteger(1), prueba.ponerJugador(1, 150, 264), prueba.soltarPeligro('mina', 300, 250), prueba.crearEnemigo('demonio_caminante', 300, 264), prueba.enfurecerEnemigo(0), true)"},
    {"wait": 400},
    {"verificar": "a los demonios no les hace nada: solo afecta a los jugadores", "eval": "prueba.peligros().length === 1"},
    {"eval": "(prueba.sinEnemigos(), prueba.equipar(1, 'shuriken'), prueba.mirar(1, 1), prueba.disparar(1), true)"},
    {"hasta": "prueba.peligros().length === 0", "timeout": 1500, "nombre": "el shuriken llega a la mina"},
    {"verificar": "un proyectil la hace explotar", "eval": "prueba.jugador(1).aturdido === false"},

    {"eval": "(prueba.configurar('ESPERA_BOMBA_ESPECIAL', 400), prueba.soltarPeligro('bomba-especial', 400, 250), true)"},
    {"verificar": "la bomba especial cae y espera", "eval": "prueba.peligros().length === 1"},
    {"hasta": "prueba.peligros().length === 0", "timeout": 1500, "nombre": "la bomba especial explota sola"},
    {"eval": "(prueba.configurar('ESPERA_BOMBA_ESPECIAL', 4000), prueba.ponerModGlobal('minas', true), Math.random = () => 0, escena.spawnearMoneda(), Math.random = azarReal, true)"},
    {"verificar": "con el pergamino, a veces cae una mina en vez de una moneda", "eval": "prueba.peligros().length === 1 && prueba.items().length === 0"},
    {"eval": "(prueba.completarRecoleccion(), true)"},
    {"hasta": "prueba.estado().fase === 'caceria'", "timeout": 8000, "nombre": "empieza la Cacería"},
    {"verificar": "la mina no se va al pasar a la Cacería", "eval": "prueba.peligros().length === 1"}
  ]
}
