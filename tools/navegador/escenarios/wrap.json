{
  "descripcion": "Wrap en el nivel de prueba: ninja, ítems, enemigos y proyectiles cruzan los 4 lados; el ninja muerto no",
  "query": "?debug&nivel=3&mapa=n-wrap",
  "pasos": [
    {"hasta": "window.prueba && prueba.enJuego()", "timeout": 8000, "nombre": "arranca el nivel"},
    {"verificar": "el nivel de prueba carga y no se mezcla con los niveles al azar", "eval": "prueba.nivel().id === 'n-wrap'"},
    {"hasta": "prueba.estado().fase === 'recoleccion'", "timeout": 4000, "nombre": "arranca la Recolección"},
    {"eval": "(prueba.sinEnemigos(), prueba.sinCajasArmas(), prueba.sinItems(), true)"},
    {"hasta": "prueba.listo(1)", "timeout": 4000, "nombre": "J1 aterriza"},
    {"verificar": "al aparecer no cruza: cae desde arriba y aterriza en su pasarela", "eval": "prueba.jugador(1)", "espera": {"x": 104, "y": {"min": 60, "max": 80}, "enPiso": true}},
    {"shot": "nivel"},
    {"eval": "(prueba.proteger(1), prueba.ponerJugador(1, -10, 240, -140, 0), true)"},
    {"wait": 200},
    {"verificar": "sale por la izquierda y entra por la derecha", "eval": "prueba.jugador(1)", "espera": {"x": {"min": 460}, "muerto": false}},
    {"eval": "(prueba.ponerJugador(1, 522, 240, 140, 0), true)"},
    {"wait": 200},
    {"verificar": "sale por la derecha y entra por la izquierda", "eval": "prueba.jugador(1)", "espera": {"x": {"max": 60}, "muerto": false}},
    {"eval": "(prueba.ponerJugador(1, 104, 290, 0, 100), true)"},
    {"hasta": "prueba.jugador(1).y < 100 && prueba.jugador(1).enPiso", "timeout": 2000, "nombre": "cae por el hueco del piso y aterriza arriba"},
    {"verificar": "cae por el piso y entra por el techo", "eval": "prueba.jugador(1)", "espera": {"x": 104, "y": {"min": 60, "max": 80}, "muerto": false}},
    {"eval": "(prueba.ponerJugador(1, 104, -10, 0, -300), true)"},
    {"wait": 100},
    {"verificar": "sube por el techo y entra por el piso", "eval": "prueba.jugador(1)", "espera": {"y": {"min": 200}, "muerto": false}},
    {"eval": "(prueba.ponerJugador(1, 22, 100), true)"},
    {"down": "ArrowLeft"},
    {"wait": 350},
    {"verificar": "en pantalla la pared frena la caída", "eval": "prueba.jugador(1)", "espera": {"vy": {"min": 1, "max": 90}}},
    {"eval": "(prueba.ponerJugador(1, 22, -14), true)"},
    {"hasta": "prueba.jugador(1).y >= -6", "timeout": 1000, "nombre": "cae por la zona oculta pegado a la pared"},
    {"verificar": "fuera de la pantalla no hay agarre: cae sin freno", "eval": "prueba.jugador(1)", "espera": {"vy": {"min": 100}}},
    {"up": "ArrowLeft"},
    {"eval": "(prueba.ponerJugador(1, 200, 264), prueba.crearItem('coin', 408, 285), true)"},
    {"wait": 1200},
    {"verificar": "una moneda que cae por el hueco no se pierde: reaparece arriba", "eval": "prueba.items()[0].y < 100"},
    {"eval": "(prueba.sinItems(), prueba.crearEnemigo('demonio_caminante', -17, 264), true)"},
    {"wait": 50},
    {"verificar": "los enemigos también cruzan", "eval": "prueba.enemigo(0).x > 450"},
    {"eval": "(prueba.sinEnemigos(), prueba.ponerJugador(1, 104, 72), prueba.proyectilEnemigo(500, 250, 200, 0), true)"},
    {"wait": 1000},
    {"verificar": "un proyectil que sale de la pantalla sigue en juego", "eval": "prueba.proyectiles().enemigos === 1"},
    {"wait": 3300},
    {"verificar": "los proyectiles tienen duración máxima", "eval": "prueba.proyectiles().enemigos === 0"},
    {"eval": "(prueba.completarRecoleccion(), true)"},
    {"hasta": "prueba.estado().fase === 'caceria'", "timeout": 4000, "nombre": "empieza la Cacería"},
    {"eval": "(prueba.sinEnemigos(), prueba.ponerJugador(1, 200, 264), prueba.quitarProteccion(1), prueba.golpear(1, 1), true)"},
    {"hasta": "prueba.estado().vidas[0] === 2", "timeout": 3000, "nombre": "el ninja muerto cae y pierde la vida"},
    {"verificar": "el ninja muerto no cruza: sale de la pantalla y pierde la vida", "eval": "prueba.jugador(1).y > 288"}
  ]
}
