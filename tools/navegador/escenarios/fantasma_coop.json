{
  "descripcion": "Fantasmas con dos jugadores: uno para cada uno, desaparecen al matar y el último decide el recomienzo",
  "query": "?debug&nivel=1&jugadores=2",
  "pasos": [
    {"hasta": "window.prueba && prueba.enJuego() && prueba.estado().fase === 'recoleccion'", "timeout": 8000, "nombre": "arranca la Recolección"},
    {"hasta": "prueba.listo(1) && prueba.listo(2)", "timeout": 4000, "nombre": "los dos en el piso"},
    {"eval": "window.tocar = (n, i = 0) => { const f = prueba.fantasmas()[i]; prueba.quitarProteccion(n); prueba.ponerJugador(n, f.x, f.y); }; (prueba.sinEnemigos(), prueba.sinCajasArmas(), prueba.ponerJugador(1, 60, 264), prueba.ponerJugador(2, 200, 264), prueba.ponerTiempo(1))"},
    {"hasta": "prueba.estado().fantasma", "timeout": 2500, "nombre": "aparecen los fantasmas"},
    {"verificar": "son dos y persiguen a cada jugador", "eval": "prueba.fantasmas().map(f => f.objetivo).sort().join() === '1,2'"},
    {"verificar": "los dos entran por el costado más lejano a los jugadores", "eval": "prueba.fantasmas().every(f => f.x > 400)"},
    {"shot": "dos_fantasmas"},
    {"hasta": "prueba.fantasmas().every(f => f.x < 495)", "timeout": 3000, "nombre": "los fantasmas entran a la pantalla"},
    {"eval": "(tocar(1, 1), true)"},
    {"wait": 100},
    {"verificar": "cualquier fantasma mata a cualquiera, y el que desaparece es el del muerto", "eval": "({ muerto: prueba.jugador(1).muerto, fantasmas: prueba.fantasmas().length })", "espera": {"muerto": true, "fantasmas": 1}},
    {"verificar": "el fantasma que tocó a J1 sigue tras J2, su jugador", "eval": "(prueba.ponerJugador(2, 30, 264), prueba.fantasmas()[0].objetivo === 2)"},
    {"hasta": "prueba.estado().vidas[0] === 2", "timeout": 3000, "nombre": "J1 pierde la vida"},
    {"wait": 2600},
    {"verificar": "con el reloj en cero nadie reaparece, y mientras quede uno en pie la fase sigue", "eval": "({ ...prueba.estado(), muerto: prueba.jugador(1).muerto })", "espera": {"fase": "recoleccion", "muerto": true, "fantasma": true, "tiempo": 0}},
    {"eval": "(tocar(2), true)"},
    {"hasta": "prueba.estado().vidas[1] === 2", "timeout": 3000, "nombre": "J2 pierde la vida con el último fantasma"},
    {"hasta": "prueba.estado().fase === 'recoleccion' && prueba.estado().tiempo > 5", "timeout": 8000, "nombre": "el nivel recomienza"},
    {"verificar": "sin nadie en pie el nivel recomienza con los dos", "eval": "prueba.estado()", "espera": {"vidas": [2, 2], "fantasma": false}},
    {"hasta": "prueba.listo(1) && prueba.listo(2)", "timeout": 4000, "nombre": "los dos en el piso de nuevo"},
    {"eval": "(prueba.sinEnemigos(), prueba.sinCajasArmas(), prueba.ponerJugador(1, 60, 264), prueba.ponerJugador(2, 200, 264), prueba.ponerTiempo(1))"},
    {"hasta": "prueba.estado().fantasma", "timeout": 2500, "nombre": "aparecen los fantasmas de nuevo"},
    {"hasta": "prueba.fantasmas().every(f => f.x < 495)", "timeout": 3000, "nombre": "entran a la pantalla"},
    {"eval": "(tocar(1), true)"},
    {"hasta": "prueba.estado().vidas[0] === 1", "timeout": 3000, "nombre": "J1 cae y queda esperando"},
    {"eval": "(prueba.completarRecoleccion(2), true)"},
    {"hasta": "prueba.estado().fase === 'caceria'", "timeout": 3000, "nombre": "J2 termina la Recolección solo"},
    {"hasta": "!prueba.jugador(1).muerto", "timeout": 2000, "nombre": "J1 reaparece cuando el reloj vuelve a empezar"},
    {"verificar": "al cambiar de fase vuelve el que esperaba", "eval": "prueba.estado()", "espera": {"fase": "caceria", "tiempo": {"min": 25}, "fantasma": false}},
    {"wait": 1600, "eval": "(prueba.sinEnemigos(), prueba.crearEnemigo('demonio_caminante', 250, 264), prueba.proteger(1), prueba.proteger(2), prueba.ponerVidas(1, 2), prueba.ponerTiempo(1))"},
    {"hasta": "prueba.estado().fantasma", "timeout": 2500, "nombre": "se acaba el tiempo de la Cacería"},
    {"hasta": "prueba.fantasmas().every(f => f.x < 495)", "timeout": 3000, "nombre": "los fantasmas entran a la pantalla"},
    {"eval": "(tocar(1), prueba.ponerJugador(2, 30, 264), true)"},
    {"hasta": "prueba.estado().vidas[0] === 1", "timeout": 3000, "nombre": "J1 cae"},
    {"wait": 2600},
    {"verificar": "en la Cacería con fantasma, quien muere no reaparece: el compañero puede terminar", "eval": "({ ...prueba.estado(), muerto: prueba.jugador(1).muerto })", "espera": {"fase": "caceria", "muerto": true, "fantasma": true}},
    {"eval": "(tocar(2), true)"},
    {"hasta": "prueba.estado().vidas[1] === 1", "timeout": 3000, "nombre": "J2 cae"},
    {"hasta": "!prueba.jugador(1).muerto && !prueba.jugador(2).muerto", "timeout": 4000, "nombre": "reaparecen los dos"},
    {"verificar": "cuando no queda nadie en pie, la Cacería recomienza con los que tienen vidas", "eval": "prueba.estado()", "espera": {"fase": "caceria", "tiempo": {"min": 25}, "fantasma": false, "vidas": [1, 1]}},
    {"hasta": "prueba.listo(1) && prueba.listo(2)", "timeout": 4000, "nombre": "los dos en el piso"},
    {"eval": "(prueba.sinEnemigos(), prueba.crearEnemigo('demonio_caminante', 250, 264), prueba.proteger(1), prueba.proteger(2), prueba.ponerTiempo(1))"},
    {"hasta": "prueba.estado().fantasma", "timeout": 2500, "nombre": "otra vez sin tiempo"},
    {"eval": "(prueba.quitarProteccion(1), prueba.golpear(1), prueba.ponerJugador(2, 30, 264), true)"},
    {"verificar": "si lo mata otra cosa, su fantasma también desaparece", "eval": "prueba.fantasmas().length === 1"},
    {"hasta": "prueba.jugador(1).eliminado", "timeout": 3000, "nombre": "J1 se queda sin vidas"},
    {"verificar": "J2 sigue solo con el último fantasma", "eval": "({ fantasmas: prueba.fantasmas().length, objetivo: prueba.fantasmas()[0].objetivo, fase: prueba.estado().fase })", "espera": {"fantasmas": 1, "objetivo": 2, "fase": "caceria"}},
    {"eval": "(tocar(2), true)"},
    {"hasta": "prueba.estado().fase === 'fin'", "timeout": 5000, "nombre": "sin vidas para nadie termina la partida"},
    {"verificar": "la partida termina cuando todos se quedan sin vidas", "eval": "prueba.estado().vidas.join() === '0,0'"}
  ]
}
