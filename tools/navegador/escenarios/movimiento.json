{
  "descripcion": "Movimiento del ninja con el teclado: mide salto, doble salto, dash, caída y paredes, para que no cambien al tocar el código",
  "query": "?debug&nivel=3&mapa=n-peligros",
  "pasos": [
    {"hasta": "window.prueba && prueba.enJuego() && prueba.estado().fase === 'recoleccion'", "timeout": 8000, "nombre": "arranca la Recolección"},
    {"hasta": "prueba.listo(1)", "timeout": 4000, "nombre": "J1 en el piso"},
    {"wait": 2200},
    {"eval": "(prueba.sinEnemigos(), prueba.sinCajasArmas(), prueba.sinFuego(), prueba.sinItems(), prueba.ponerTiempo(90), true)"},
    {"verificar": "el ninja arranca sin movimientos especiales", "eval": "Object.values(prueba.habilidades(1)).every(nivel => nivel === 0)"},
    {"eval": "(prueba.proteger(1), prueba.ponerJugador(1, 160, 264), true)"},
    {"wait": 350},
    {"eval": "window.x0 = prueba.jugador(1).x"},
    {"press": "ArrowRight", "delay": 30},
    {"wait": 40},
    {"press": "ArrowRight", "delay": 30},
    {"wait": 200},
    {"verificar": "sin el pergamino, el doble toque no hace dash", "eval": "prueba.jugador(1).x - x0 < 30"},
    {"eval": "prueba.darHabilidades(1)"},
    {"eval": "window.medir = (ms) => { window.traza = []; const fin = performance.now() + ms; const paso = () => { traza.push(prueba.jugador(1)); if (performance.now() < fin) requestAnimationFrame(paso); }; paso(); return true; }; window.alto = (y0) => y0 - Math.min(...traza.map(j => j.y)); window.enPie = (x) => (prueba.proteger(1), prueba.ponerJugador(1, x, 264), true); true"},

    {"eval": "enPie(200)"},
    {"wait": 400},
    {"eval": "medir(900)"},
    {"press": "KeyZ", "delay": 500},
    {"wait": 500},
    {"verificar": "salto completo: sube 76 px y vuelve al piso", "eval": "({ alto: alto(264), enPiso: prueba.jugador(1).enPiso })", "espera": {"alto": {"min": 70, "max": 82}, "enPiso": true}},

    {"wait": 300},
    {"eval": "medir(700)"},
    {"press": "KeyZ", "delay": 40},
    {"wait": 750},
    {"verificar": "soltar enseguida corta el salto", "eval": "({ alto: alto(264) })", "espera": {"alto": {"min": 8, "max": 45}}},

    {"wait": 300},
    {"eval": "medir(1000)"},
    {"press": "KeyZ", "delay": 120},
    {"wait": 120},
    {"press": "KeyZ", "delay": 300},
    {"wait": 700},
    {"verificar": "el doble salto sube más que uno solo", "eval": "({ alto: alto(264) })", "espera": {"alto": {"min": 85, "max": 150}}},

    {"wait": 300},
    {"eval": "(prueba.ponerJugador(1, 240, 248, 0, 60), true)"},
    {"wait": 30},
    {"eval": "medir(350)"},
    {"press": "KeyZ", "delay": 200},
    {"wait": 200},
    {"verificar": "apretar justo antes de tocar el piso igual salta", "eval": "({ alto: alto(264) })", "espera": {"alto": {"min": 25}}},

    {"wait": 900},
    {"eval": "enPie(160)"},
    {"wait": 350},
    {"eval": "(window.x0 = prueba.jugador(1).x, medir(400))"},
    {"press": "ArrowRight", "delay": 30},
    {"wait": 40},
    {"press": "ArrowRight", "delay": 30},
    {"verificar": "durante el dash el ninja está en ese estado", "eval": "prueba.jugador(1).estado === 'dash'"},
    {"wait": 330},
    {"verificar": "al terminar el dash vuelve a estar libre", "eval": "prueba.jugador(1).estado === 'libre'"},
    {"verificar": "doble toque: el dash recorre unos 70 px sin caer", "eval": "({ avance: prueba.jugador(1).x - x0, rapido: Math.max(...traza.map(j => j.vx)), subio: alto(264) })", "espera": {"avance": {"min": 60, "max": 110}, "rapido": {"min": 330, "max": 360}, "subio": {"max": 1}}},

    {"wait": 600},
    {"eval": "(prueba.ponerJugador(1, 200, 100, 0, 0), true)"},
    {"press": "ArrowDown", "delay": 40},
    {"wait": 40},
    {"verificar": "un solo toque abajo en el aire no es caída pesada", "eval": "({ rapida: prueba.jugador(1).vy >= 470 })", "espera": {"rapida": false}},
    {"eval": "(prueba.ponerJugador(1, 200, 100, 0, 0), true)"},
    {"press": "ArrowDown", "delay": 40},
    {"wait": 40},
    {"press": "ArrowDown", "delay": 40},
    {"wait": 60},
    {"verificar": "doble toque abajo en el aire acelera la caída, aunque se suelte", "eval": "prueba.jugador(1).vy >= 470"},
    {"wait": 400},

    {"eval": "(prueba.proteger(1), prueba.ponerJugador(1, 100, 184), true)"},
    {"wait": 250},
    {"verificar": "se para sobre la pasarela", "eval": "prueba.jugador(1)", "espera": {"y": {"min": 182, "max": 186}, "enPiso": true}},
    {"press": "ArrowDown", "delay": 80},
    {"wait": 300},
    {"verificar": "abajo sobre una pasarela la atraviesa", "eval": "prueba.jugador(1).y > 200"},
    {"wait": 400},

    {"eval": "(prueba.proteger(1), prueba.ponerJugador(1, 22, 150, -60, 40), true)"},
    {"down": "ArrowLeft"},
    {"wait": 60},
    {"eval": "medir(300)"},
    {"up": "ArrowLeft"},
    {"down": "ArrowRight"},
    {"press": "KeyZ", "delay": 120},
    {"up": "ArrowRight"},
    {"wait": 120},
    {"verificar": "salto de pared: sube y se aleja de la pared", "eval": "({ vxMax: Math.max(...traza.map(j => j.vx)), vyMin: Math.min(...traza.map(j => j.vy)), x: prueba.jugador(1).x })", "espera": {"vxMax": {"min": 100}, "vyMin": {"max": -150}, "x": {"min": 30}}},

    {"wait": 900},
    {"eval": "enPie(200)"},
    {"wait": 350},
    {"eval": "(prueba.quitarProteccion(1), prueba.golpear(1, 1), true)"},
    {"verificar": "aturdido sale despedido", "eval": "prueba.jugador(1)", "espera": {"aturdido": true, "vx": {"max": -100}}},
    {"down": "ArrowRight"},
    {"wait": 250},
    {"verificar": "aturdido no se controla", "eval": "prueba.jugador(1).vx <= 0"},
    {"up": "ArrowRight"},
    {"hasta": "!prueba.jugador(1).aturdido", "timeout": 1500, "nombre": "se recupera"},
    {"verificar": "sigue parpadeando un rato después del aturdimiento", "eval": "prueba.jugador(1).invulnerable"},
    {"hasta": "!prueba.jugador(1).invulnerable", "timeout": 2500, "nombre": "termina el parpadeo"},
    {"verificar": "al terminar el parpadeo vuelve a ser opaco", "eval": "window.game.scene.getScene('NinjaMonchoScene').jugador.alpha === 1"}
  ]
}
