{
  "descripcion": "Tiles de trampa y fuego: dañan según la fase, enfurecen enemigos sin hacerlos vulnerables, y las bolas terminan en llamas",
  "query": "?debug&nivel=3&mapa=n-peligros",
  "pasos": [
    {"hasta": "window.prueba && prueba.enJuego() && prueba.estado().fase === 'recoleccion'", "timeout": 8000, "nombre": "arranca la Recolección"},
    {"hasta": "prueba.listo(1)", "timeout": 4000, "nombre": "J1 en el piso"},
    {"verificar": "el nivel registra sus 2 tiles de fuego", "eval": "prueba.fuego().tiles === 2"},
    {"verificar": "el fuego tiene 4 cuadros detectados solos, sin contar los tiles vacíos", "eval": "window.game.anims.get('tile-fuego').frames.length === 4"},
    {"verificar": "la llama anima todos los cuadros de su PNG", "eval": "window.game.anims.get('llama').frames.length === 4"},
    {"eval": "(prueba.sinEnemigos(), prueba.sinCajasArmas(), prueba.sinItems(), prueba.proteger(1), prueba.vaciarTalismanes(), prueba.juntarTalismanes({cuadrado: 2}), prueba.sinFuego())"},
    {"shot": "nivel"},
    {"eval": "(prueba.quitarProteccion(1), prueba.ponerJugador(1, 376, 250, 0, 100), true)"},
    {"hasta": "prueba.jugador(1).aturdido", "timeout": 1000, "nombre": "J1 cae sobre la trampa"},
    {"verificar": "en la Recolección la trampa aturde y cuesta los talismanes, no una vida", "eval": "prueba.estado()", "espera": {"vidas": [3, 3], "talismanes": {"cuadrado": 0, "triangulo": 0, "rombo": 0}}},
    {"hasta": "!prueba.jugador(1).invulnerable", "timeout": 3000, "nombre": "termina el parpadeo"},
    {"eval": "(prueba.ponerJugador(1, 200, 264), prueba.proteger(1), prueba.crearEnemigo('demonio_caminante', 376, 250), true)"},
    {"hasta": "prueba.enemigo(0).enfurecido", "timeout": 1000, "nombre": "un enemigo toca la trampa"},
    {"verificar": "la trampa lo enfurece, pero en la Recolección sigue sin poder morir", "eval": "(prueba.ponerVidaEnemigo(0, 1), prueba.reglas().enemigosVulnerables === false && prueba.enemigo(0).hp === 1)"},
    {"eval": "(prueba.sinEnemigos(), prueba.crearBola(200, 200, 0, -40), true)"},
    {"verificar": "una bola de fuego es un proyectil de los demonios", "eval": "prueba.fuego().bolas === 1 && prueba.proyectiles().enemigos === 1"},
    {"hasta": "prueba.fuego().llamas === 1", "timeout": 6000, "nombre": "la bola rebota y queda quieta"},
    {"verificar": "al quedar quieta se convierte en una llama", "eval": "prueba.fuego().bolas === 0"},
    {"shot": "llama"},
    {"eval": "(prueba.vaciarTalismanes(), prueba.juntarTalismanes({rombo: 1}), prueba.quitarProteccion(1), prueba.ponerJugador(1, 200, 264), true)"},
    {"hasta": "prueba.jugador(1).aturdido", "timeout": 1000, "nombre": "J1 pisa la llama"},
    {"verificar": "la llama aturde en la Recolección", "eval": "prueba.estado()", "espera": {"vidas": [3, 3], "talismanes": {"cuadrado": 0, "triangulo": 0, "rombo": 0}}},
    {"eval": "(prueba.crearEnemigo('demonio_caminante', 200, 264), true)"},
    {"wait": 100},
    {"verificar": "la llama enfurece a los enemigos y no los mata", "eval": "prueba.enemigo(0)", "espera": {"enfurecido": true, "muerto": false}},
    {"hasta": "prueba.fuego().llamas === 0", "timeout": 7000, "nombre": "la llama se apaga sola"},
    {"eval": "(prueba.sinEnemigos(), prueba.proteger(1), prueba.ponerJugador(1, 100, 264), prueba.mirar(1, 1), prueba.crearBola(112, 262, 0, 0), prueba.atacar(1), true)"},
    {"wait": 120},
    {"verificar": "a una bola se le puede hacer parry con la katana", "eval": "prueba.fuego().bolas === 0"},
    {"eval": "(prueba.proteger(1), prueba.ponerJugador(1, 60, 264), prueba.crearBola(300, 150, 60, 0), true)"},
    {"verificar": "las bolas pasan a través de los enemigos sin dañarlos: son del mismo bando", "eval": "(prueba.crearEnemigo('demonio_caminante', 300, 150), prueba.ponerVidaEnemigo(0, 2), true)"},
    {"wait": 200},
    {"verificar": "la vida del enemigo sigue igual", "eval": "prueba.enemigo(0).hp === 2"},
    {"eval": "(prueba.sinEnemigos(), prueba.completarRecoleccion(), true)"},
    {"hasta": "prueba.estado().fase === 'caceria'", "timeout": 4000, "nombre": "empieza la Cacería"},
    {"wait": 1600, "eval": "(prueba.sinEnemigos(), prueba.crearEnemigo('demonio_caminante', 100, 264), prueba.quitarProteccion(1), prueba.ponerJugador(1, 376, 250, 0, 100), true)"},
    {"hasta": "prueba.jugador(1).muerto", "timeout": 1000, "nombre": "J1 cae sobre la trampa en la Cacería"},
    {"hasta": "prueba.estado().vidas[0] === 2", "timeout": 3000, "nombre": "pierde la vida al caer"},
    {"verificar": "en la Cacería la trampa cuesta una vida", "eval": "prueba.estado().fase === 'caceria'"}
  ]
}
