{
  "descripcion": "Traducciones por API: lectura, frases faltantes y copia guardada si la API cae (API simulada en tools/navegador/datos)",
  "query": "?debug&api=tools/navegador/datos&proyecto=prueba",
  "pasos": [
    {"hasta": "!!window.i18n && !!window.game", "timeout": 8000},
    {"verificar": "origen api", "eval": "i18n.getOrigenes()", "espera": {"en": "api"}},
    {"verificar": "español local", "eval": "i18n.t('menu_1p') === '1 JUGADOR'"},
    {"eval": "i18n.setIdioma('en')"},
    {"verificar": "inglés desde la API", "eval": "i18n.t('menu_1p') === 'API PLAYER'"},
    {"verificar": "saltos de línea restaurados", "eval": "i18n.t('reintentar').split(String.fromCharCode(10)).join('#') === 'RETRY API#MENU API'"},
    {"verificar": "traducción vacía usa respaldo local", "eval": "i18n.t('menu_opciones') === 'SETTINGS'"},
    {"verificar": "frase ausente usa respaldo local", "eval": "i18n.t('menu_2p') === '2 PLAYERS'"},
    {"verificar": "se guardó la copia", "eval": "!!localStorage.getItem('ninjaMoncho.traducciones.prueba.en')"},
    {"eval": "(location.href = location.href.replace('proyecto=prueba', 'proyecto=prueba&api=http://127.0.0.1:1').replace('api=tools/navegador/datos&', ''), true)"},
    {"wait": 500},
    {"hasta": "!!window.i18n && !!window.game && Object.keys(i18n.getOrigenes()).length", "timeout": 8000},
    {"verificar": "API caída usa la copia guardada", "eval": "i18n.getOrigenes()", "espera": {"en": "copia"}},
    {"eval": "i18n.setIdioma('en')"},
    {"verificar": "la copia traduce", "eval": "i18n.t('menu_1p') === 'API PLAYER'"}
  ]
}
